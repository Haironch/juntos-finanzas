# Solo servidor; no incluir estas variables en public/ ni en el navegador.
# Sin TURSO_DATABASE_URL se usa la base local .data/juntos.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Inicio de sesión (Better Auth + Google). Generar el secreto con: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Usar 127.0.0.1 (no localhost). Si se cambia PORT, cambiar también el puerto aquí y en Google.
BETTER_AUTH_URL=http://127.0.0.1:5173
PORT=
# Google Cloud > APIs y servicios > Credenciales > ID de cliente OAuth (aplicación web).
# URI de redirección autorizado: http://127.0.0.1:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Únicos correos que pueden crear cuenta, separados por coma.
ALLOWED_EMAILS=
